&Тест
Процедура ТестДопустимоеРасширениеНижнийРегистр() Экспорт
    Ожидаем.Что(РаботаСМодулями.ДопустимоеРасширение("epf")).Равно(Истина);
    Ожидаем.Что(РаботаСМодулями.ДопустимоеРасширение("ert")).Равно(Истина);
    Ожидаем.Что(РаботаСМодулями.ДопустимоеРасширение("cf")).Равно(Истина);
    Ожидаем.Что(РаботаСМодулями.ДопустимоеРасширение("cfe")).Равно(Истина);
КонецПроцедуры

&Тест
Процедура ТестДопустимоеРасширениеВерхнийРегистр() Экспорт
    Ожидаем.Что(РаботаСМодулями.ДопустимоеРасширение("EPF")).Равно(Истина);
    Ожидаем.Что(РаботаСМодулями.ДопустимоеРасширение("ERT")).Равно(Истина);
    Ожидаем.Что(РаботаСМодулями.ДопустимоеРасширение("CF")).Равно(Истина);
    Ожидаем.Что(РаботаСМодулями.ДопустимоеРасширение("CFE")).Равно(Истина);
КонецПроцедуры

&Тест
Процедура ТестНедопустимоеРасширение() Экспорт
    Ожидаем.Что(РаботаСМодулями.ДопустимоеРасширение("txt")).Равно(Ложь);
    Ожидаем.Что(РаботаСМодулями.ДопустимоеРасширение("zip")).Равно(Ложь);
    Ожидаем.Что(РаботаСМодулями.ДопустимоеРасширение("exe")).Равно(Ложь);
    Ожидаем.Что(РаботаСМодулями.ДопустимоеРасширение("")).Равно(Ложь);
КонецПроцедуры

&Тест
Процедура ТестТекстыМодулейПустойКаталог() Экспорт
    КаталогТест = ПолучитьИмяВременногоФайла();
    СоздатьКаталог(КаталогТест);

    Результат = РаботаСМодулями.ТекстыМодулей(КаталогТест);

    Ожидаем.Что(Результат.Количество()).Равно(0);

    УдалитьФайлы(КаталогТест);
КонецПроцедуры

&Тест
Процедура ТестТекстыМодулейСФайлами() Экспорт
    КаталогТест = ПолучитьИмяВременногоФайла();
    СоздатьКаталог(КаталогТест);

    ЗаписьТекста = Новый ЗаписьТекста(КаталогТест + "/test.bsl", КодировкаТекста.UTF8NoBOM);
    ЗаписьТекста.ЗаписатьСтроку("Процедура Тест()");
    ЗаписьТекста.ЗаписатьСтроку("КонецПроцедуры");
    ЗаписьТекста.Закрыть();

    Результат = РаботаСМодулями.ТекстыМодулей(КаталогТест);

    Ожидаем.Что(Результат.Количество()).Равно(1);

    УдалитьФайлы(КаталогТест);
КонецПроцедуры
