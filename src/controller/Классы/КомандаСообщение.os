#Использовать oint

&Деталька("TELEGRAMM.TOKEN")
Перем Токен;

&Желудь
&Прозвище("Команда")
&Реализует("ИнтерфейсКоманда")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

Функция ПодходитПоУсловию(Сообщение) Экспорт

	Подходит = Сообщение.Получить("message") <> Неопределено И Сообщение["message"].Получить("document") = Неопределено;
	Возврат Подходит;

КонецФункции

&Асинх
Процедура Обработать(Сообщение) Экспорт

	ЧатИД = Сообщение["message"]["chat"]["id"];
	Текст = Сообщение["message"]["text"];

	Если Текст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекстКоманды = НРег(СокрЛП(Текст));

	Если ТекстКоманды = "/start" Тогда
		ТекстОтвета = ТекстПриветствия();
	ИначеЕсли ТекстКоманды = "/help" Тогда
		ТекстОтвета = ТекстПомощи();
	Иначе
		ТекстОтвета = "Неизвестная команда. Отправьте /help для справки или просто пришлите файл.";
	КонецЕсли;

	OPI_Telegram.ОтправитьТекстовоеСообщение(Токен, ЧатИД, ТекстОтвета);

КонецПроцедуры

Функция ТекстПриветствия()

	Строки = Новый Массив;
	Строки.Добавить("Привет! Я бот для публикации исходного кода 1С.");
	Строки.Добавить("");
	Строки.Добавить("Отправьте мне файл конфигурации или обработки, и я:");
	Строки.Добавить("1. Разберу его на модули");
	Строки.Добавить("2. Опубликую исходный код на GitHub Gist");
	Строки.Добавить("3. Отправлю вам ссылку");
	Строки.Добавить("");
	Строки.Добавить("Поддерживаемые форматы: .epf, .ert, .cf, .cfe");
	Строки.Добавить("");
	Строки.Добавить("Отправьте /help для подробной справки.");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ТекстПомощи()

	Строки = Новый Массив;
	Строки.Добавить("Справка по боту Share BSL");
	Строки.Добавить("");
	Строки.Добавить("Поддерживаемые форматы файлов:");
	Строки.Добавить("  .epf — внешние обработки");
	Строки.Добавить("  .ert — внешние отчёты");
	Строки.Добавить("  .cf — конфигурации");
	Строки.Добавить("  .cfe — расширения конфигураций");
	Строки.Добавить("");
	Строки.Добавить("Как пользоваться:");
	Строки.Добавить("  1. Отправьте файл боту");
	Строки.Добавить("  2. Бот разберёт файл и опубликует код");
	Строки.Добавить("  3. Вы получите ссылку на GitHub Gist");
	Строки.Добавить("");
	Строки.Добавить("При повторной отправке файла с тем же именем бот предложит обновить предыдущую публикацию или создать новую.");
	Строки.Добавить("");
	Строки.Добавить("Ограничение размера файла: 20 МБ");
	Строки.Добавить("");
	Строки.Добавить("Команды:");
	Строки.Добавить("  /start — приветствие");
	Строки.Добавить("  /help — эта справка");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции
