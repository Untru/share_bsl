#Использовать oint 


&Деталька("TELEGRAMM.TOKEN")
Перем Токен;

&Пластилин("Команда", Тип = "Массив")
Перем Команды;

&ЛогПубликация
Перем Лог;

&Число
Перем Смещение;

&Желудь
Процедура ПриСозданииОбъекта()
	
КонецПроцедуры

Процедура Запустить() Экспорт
	Лог.Отладка("Запущен");

	Лог.Информация("Токен: задан");
	Лог.Информация("Команд загружено: " + Команды.Количество());

	Пока Истина Цикл

		Попытка
			Ответ = OPI_Telegram.ПолучитьОбновления(Токен, 30, Смещение);
		Исключение
			Лог.Ошибка("Ошибка получения обновлений: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Приостановить(5000);
			Продолжить;
		КонецПопытки;

		Результат = Ответ["result"];

		Если Результат = Неопределено Тогда
			Лог.Отладка("Ответ не содержит result: " + OPI_Инструменты.JSONСтрокой(Ответ, , Ложь, Ложь));
			Продолжить;
		КонецЕсли;

		Если Результат.ВГраница() = -1 Тогда
			Продолжить;
		КонецЕсли;

		Лог.Информация("Получено обновлений: " + Результат.Количество());

		Для Каждого Сообщение Из Результат Цикл
			Смещение = Сообщение["update_id"] + 1;

			КомандаНайдена = Ложь;
			Для Каждого Команда Из Команды Цикл
				Если Команда.ПодходитПоУсловию(Сообщение) Тогда
					Лог.Информация("Обработка: update_id=" + Сообщение["update_id"]);
					Попытка
						Команда.Обработать(Сообщение);
					Исключение
						Лог.Ошибка("Ошибка обработки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					КонецПопытки;
					КомандаНайдена = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			Если НЕ КомандаНайдена Тогда
				Лог.Отладка("Нет подходящей команды для update_id=" + Сообщение["update_id"]);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;
	
КонецПроцедуры
