
#Область ОбъявлениеПеременных

&Пластилин
Перем ТелеграммБот;

&ЛогПубликация
Перем Лог;

#КонецОбласти

#Область ПубличныйИнтерфейс

&Рогатка
Процедура ПриСозданииОбъекта()
КонецПроцедуры

Процедура ПриЗапускеПриложения() Экспорт

	МаксПопыток = 10;
	Задержка = 5000; // 5 секунд начальная задержка

	Для Счетчик = 1 По МаксПопыток Цикл

		Попытка
			Лог.Информация("Старт");
			ТелеграммБот.Запустить();
		Исключение
			Лог.Ошибка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			Если Счетчик < МаксПопыток Тогда
				Лог.Информация("Повторный запуск через " + Цел(Задержка / 1000) + " сек (попытка " + (Счетчик + 1) + "/" + МаксПопыток + ")");
				Приостановить(Задержка);
				// Exponential backoff: 5s, 10s, 20s, 40s, 60s, 60s...
				Задержка = Мин(Задержка * 2, 60000);
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;

	Лог.Ошибка("Не удалось запустить бот после " + МаксПопыток + " попыток");

КонецПроцедуры

#КонецОбласти
